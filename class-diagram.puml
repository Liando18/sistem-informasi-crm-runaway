@startuml
skinparam class {
  BackgroundColor #F8F8FF
  BorderColor #333333
  FontColor #000000
  HeaderBackgroundColor #A9D0F5
  HeaderFontColor #000000
}
skinparam classAttributeIconSize 0

hide empty methods
hide stereotype
hide circle

' ====================================================================
' ENTITY CLASSES
' ====================================================================

class Akun {
- id_akun : int
- nama : varchar(30)
- email : varchar(100)
- password : varchar(10)
- role : varchar(20)
- no_telp : varchar(20)
- alamat : text
- email_verified_at : datetime
- created_at : datetime
- updated_at : datetime
--
- create()
- read()
- update()
- delete()
}

class Chat {
- id_chat : int
- akun_pengirim : int
- akun_penerima : int
