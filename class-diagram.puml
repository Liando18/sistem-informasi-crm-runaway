' ====================================================================
' RELATIONSHIPS
' ====================================================================

Akun "1" -right-> "N" Keranjang
Akun "1" -right-> "N" Pesanan
Akun "1" -right-> "N" Testimoni
Akun "1" --> "N" Chat
Akun "1" -right-> "N" Diskon

Kategori "1" -down-> "N" Produk

Diskon "1" -down-> "N" Produk
Diskon "1" -down-> "N" Pesanan

Produk "1" -down-> "N" Keranjang
Produk "1" -down-> "N" DetailPesanan
Produk "1" -down-> "N" Testimoni
Produk "1" -down-> "N" ProdukGambar
Produk "1" -down-> "N" ProdukVariasi

ProdukVariasi "1" -right-> "N" DetailPesanan
ProdukVariasi "1" -right-> "N" Keranjang

Pesanan "1" -down-> "1" Pembayaran
Pesanan "1" -down-> "N" DetailPesanan

@enduml
